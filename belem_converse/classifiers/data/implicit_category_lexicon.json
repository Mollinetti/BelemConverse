{
  "_meta": {
    "version": "1.0",
    "purpose": "Semantic phrases that imply a category WITHOUT containing any direct category keyword. Used both as a runtime Strategy-0 lookup in QueryPlanner.extract_categories AND as additional training data for the TF-IDF classifier (intent left unchanged, category set as the labelled target). Adding a phrase here is a low-risk way to teach the system about colloquial framing the keyword lexicons cannot reasonably enumerate.",
    "schema": {
      "<language>": {
        "<category>": ["<phrase>", "..."]
      }
    },
    "matching_rules": "Phrases are matched as substrings against the accent-stripped, lower-cased message. Order categories from most-specific to most-generic if a phrase could plausibly belong to multiple categories — the runtime lookup emits ALL matches. Do NOT add phrases that contain a category keyword already in the classifier (e.g. 'restaurante bom' belongs in the keyword lexicon, not here).",
    "owners": "Update freely. After substantive changes, bump MODEL_VERSION in intent_classifier_TFIDF_simple.py and re-run `python -m tests.diagnostics.run_diagnostic` to quantify the impact."
  },
