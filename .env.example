# BelemConverse environment overrides
# Copy to .env and fill in values you actually want to override.

# Path to the GGUF summarizer model. Defaults to:
#   models/llm/Meta-Llama-3.1-8B-Instruct-Q5_K_M.gguf
#MODEL_GGUF_PATH=/absolute/path/to/model.gguf

# How many layers to offload to GPU. 0 = CPU only. 35 default for M-series.
#LLM_N_GPU_LAYERS=35

# Override data + vector-store directories (useful for Docker / shared volumes).
#BELEM_DATA_DIR=/abs/path/to/data
#CHROMA_PERSIST_DIR=/abs/path/to/data/chroma_db
#BELEM_MODELS_DIR=/abs/path/to/models

# UI / language
#BELEM_MODEL=llama3.1
#BELEM_CITY=belem
