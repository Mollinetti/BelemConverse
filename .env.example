# BelemConverse environment overrides
# Copy to .env (gitignored) and fill in what you need. The API reads .env at
# startup; variables already set in the environment win.

# --- Language model (OpenAI-compatible /chat/completions) -------------------
# Leave LLM_BASE_URL unset to run without a model: every answer is then the
# template answer. Chosen by the mvp-1 benchmark (validation.md → T23;
# re-run with python -m belem_converse.tools.bench_llm MODEL --delay 6).
# Primary: Google AI Studio free tier (key from aistudio.google.com).
#LLM_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai
#LLM_MODEL=gemini-3.5-flash-lite
#LLM_API_KEY=

# Optional second provider, tried when the first is rate-limited, fails or
# times out. Groq free tier (key from console.groq.com).
#LLM_FALLBACK_BASE_URL=https://api.groq.com/openai/v1
#LLM_FALLBACK_MODEL=qwen/qwen3.8-27b
#LLM_FALLBACK_API_KEY=

# Local alternative (no key, no quota; not benchmarked): Ollama, OpenAI-compatible.
#LLM_BASE_URL=http://localhost:11434/v1
#LLM_MODEL=gemma4:e4b
#LLM_API_KEY=ollama

# Seconds shared by primary + fallback before the template answer is used.
#LLM_TIMEOUT_S=10
# Cap on the model's answer length.
#LLM_MAX_TOKENS=250

# --- Data ---------------------------------------------------------------------
# Runtime data directory. The place catalog is $BELEM_DATA_DIR/belem/places.sqlite,
# built with: python -m belem_converse.tools.build_catalog
#BELEM_DATA_DIR=/abs/path/to/data

# City profile (only "belem" ships).
#BELEMCONVERSE_CITY=belem
