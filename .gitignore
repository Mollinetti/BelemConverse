.env
.env.*
!.env.example
!.env.sample
!.env.template
*.pem
*.key
secrets/

# Docker local overrides (machine-specific env / paths)
docker-compose.override.yml

# Runtime datasets and generated artefacts (keep only on disk locally)
/data/

